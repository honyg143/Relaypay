# Copy this file to runner.env and fill in real values. Never commit runner.env.
# RPC of Aevum Testnet (HTTPS only).
RPC_URL=https://rpc-test.qday.info
# PayRelay contract address, filled in after the testnet deploy.
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Agent wallet private key. This wallet must be the agent set onchain via
# setAgent, and it needs a little tQDAY for gas. The key can ONLY execute
# due schedules inside the owner's caps, nothing else.
AGENT_PRIVATE_KEY=0x
# Poll interval in milliseconds (default 45000).
POLL_MS=45000
